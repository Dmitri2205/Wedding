{
  "name": "wedding",
  "private": true,
  "description": "Сайт приглашения — стили: LESS → html/css/style.css",
  "scripts": {
    "build:css": "lessc src/less/main.less html/css/style.css",
    "watch:css": "onchange \"src/less/**/*.less\" -- npm run build:css",
    "icons:timeline": "node scripts/generate-timeline-inline-svgs.js && node scripts/apply-timeline-blocks-to-index.js"
  },
  "devDependencies": {
    "less": "^4.2.0",
    "onchange": "^7.1.0"
  }
}
